# One place for every setting used by scripts/*.sh.
# Values already exported in your shell win (e.g. CLUSTER=x bash scripts/01-...).
: "${AWS_PROFILE:=abip007home}"                 # your IAM user's CLI profile (never root keys)
: "${AWS_REGION:=ap-south-1}"
: "${CLUSTER:=argo-eks}"                       # EKS cluster name; also prefixes IAM policies and ECR repos
: "${K8S_VERSION:=1.36}"
: "${NODE_TYPE:=t3.large}"                     # t3.large = 35 pods/node; t3.small only 11
: "${NODE_MIN:=2}"
: "${NODE_MAX:=4}"
: "${VPC_CIDR:=10.1.0.0/16}"                   # different from eks-platform-terraform (10.0.0.0/16)

: "${DOMAIN:=bestclick.click}"                 # Route 53 public hosted zone in this account
: "${APP_HOST:=argo-bmi.$DOMAIN}"              # public URL of the app
: "${ARGOCD_HOST:=argocd.$DOMAIN}"             # public URL of the Argo CD UI
: "${CERT_ARN:=}"                              # empty = find/request the ACM cert for DOMAIN + *.DOMAIN

: "${GIT_REPO_URL:=https://github.com/abip007/eks-argocd-3tier.git}"   # the repo Argo CD watches
: "${GIT_BRANCH:=main}"

export AWS_PROFILE AWS_REGION
